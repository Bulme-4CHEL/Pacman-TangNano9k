# 1. Generierte T80 CPU (aus GHDL)
read_verilog src/T80/t80_combined.v

# 2. Generiertes SystemVerilog (aus sv2v)
read_verilog src/sv_combined.v

# 3. Restliche Verilog/SystemVerilog Dateien
read_verilog -sv src/video.v

# 4. Gowin IP Cores & ROMs
# Wildcards (*.v) funktionieren unter Windows in Yosys oft nicht -> explizit listen:
read_verilog src/roms/82s123_7f.v
read_verilog src/roms/82s126_1m.v
read_verilog src/roms/82s126_3m.v
read_verilog src/roms/82s126_4a.v
read_verilog src/roms/pacman_5e.v
read_verilog src/roms/pacman_5f.v
read_verilog src/roms/pacman_6e.v
read_verilog src/roms/pacman_6f.v
read_verilog src/roms/pacman_6h.v
read_verilog src/roms/pacman_6j.v

read_verilog src/gowin_clkdiv/gowin_clkdiv.v
read_verilog src/gowin_dpb/ram.v
read_verilog src/gowin_rpll/pll_174m.v
read_verilog src/gowin_rpll/pll_240m.v

# 5. Synthese
synth_gowin -top top -json pacman.json